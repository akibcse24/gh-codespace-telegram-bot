{
  "name": "Codespace Telegram Agent & Web Terminal",
  "forwardPorts": [7681],
  "portsAttributes": {
    "7681": {
      "label": "ttyd Web Terminal",
      "onAutoForward": "ignore",
      "visibility": "public"
    }
  },
  "postStartCommand": "test -f ~/.codespace-telegram-agent/start.sh && ~/.codespace-telegram-agent/start.sh || curl -sSL 'https://gh-codespace-telegram-bot.mm-adnanakib.workers.dev/agent/setup-sshd-web-tty.sh' | bash"
}
